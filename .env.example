# ==============================================================================
# SentinelDesk AI — Environment Configuration Template
# ==============================================================================

# Server
PORT=8080
SPRING_PROFILES_ACTIVE=postgres

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentineldesk
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT Authentication
# Generate a 256-bit hex or base64 key: openssl rand -hex 64
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D6351
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# AI Provider Integration (Optional - Fallback rule-engine operates if disabled)
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=your_openai_or_gemini_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=10000

# SLA Engine Scheduler
SLA_SCHEDULER_ENABLED=true
SLA_CHECK_INTERVAL_MS=30000
